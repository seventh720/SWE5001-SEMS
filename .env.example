# Prefer bash scripts/setup-local.sh to generate local values and RSA keys.
POSTGRES_PASSWORD=replace-with-random-password
IDENTITY_DB_PASSWORD=replace-with-random-password
CATALOG_DB_PASSWORD=replace-with-random-password
# Keep the baseline until a fixed-resource pool comparison justifies changing it.
CATALOG_DB_POOL_SIZE=10
ADMISSION_DB_PASSWORD=replace-with-random-password
SEMS_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
SEMS_BOOTSTRAP_ADMIN_PASSWORD=replace-with-random-password
CATALOG_TO_ADMISSION_TOKEN=replace-with-at-least-32-random-characters
ADMISSION_TO_CATALOG_TOKEN=replace-with-at-least-32-random-characters

ORGANIZATION_ACCESS_TOKEN=replace-with-at-least-32-random-characters
