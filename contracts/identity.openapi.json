{
  "openapi": "3.0.3",
  "info": {
    "title": "SEMS Identity API",
    "version": "0.3.0"
  },
  "servers": [
    {
      "url": "http://localhost:18080"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Problem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "fieldErrors": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "username": {
            "type": "string"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "LOCKED",
              "DISABLED"
            ]
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "ATTENDEE",
                "ORGANIZER",
                "STAFF",
                "ADMIN"
              ]
            }
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "username",
          "email",
          "status",
          "roles",
          "createdAt"
        ]
      },
      "BookingProfile": {
        "type": "object",
        "properties": {
          "realName": {
            "type": "string",
            "nullable": true,
            "maxLength": 100
          },
          "email": {
            "type": "string",
            "nullable": true,
            "maxLength": 254,
            "format": "email"
          },
          "phone": {
            "type": "string",
            "nullable": true,
            "maxLength": 40
          },
          "studentId": {
            "type": "string",
            "nullable": true,
            "maxLength": 100,
            "description": "Deprecated: ignored on write and always null on read. Student IDs are not retained in reusable contacts.",
            "deprecated": true
          },
          "passportNumber": {
            "type": "string",
            "nullable": true,
            "maxLength": 100
          }
        }
      },
      "SavedContact": {
        "type": "object",
        "required": [
          "label"
        ],
        "properties": {
          "realName": {
            "type": "string",
            "nullable": true,
            "maxLength": 100
          },
          "email": {
            "type": "string",
            "nullable": true,
            "maxLength": 254,
            "format": "email"
          },
          "phone": {
            "type": "string",
            "nullable": true,
            "maxLength": 40
          },
          "passportNumber": {
            "type": "string",
            "nullable": true,
            "maxLength": 100
          },
          "id": {
            "type": "string",
            "format": "uuid",
            "readOnly": true
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "version": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "description": "Required for edits; stale updates return 409."
          }
        }
      },
      "SavedContactUpdate": {
        "allOf": [
          {
            "$ref": "#/components/schemas/SavedContact"
          },
          {
            "type": "object",
            "required": [
              "version"
            ]
          }
        ]
      },
      "UsernameChange": {
        "type": "object",
        "required": [
          "username"
        ],
        "properties": {
          "username": {
            "type": "string",
            "minLength": 3,
            "maxLength": 50,
            "pattern": "[A-Za-z0-9._-]+",
            "description": "Normalized to lowercase. Must include an alphanumeric character; admin, administrator, support, system, root and sems are reserved. Saving rechecks uniqueness."
          }
        }
      }
    }
  },
  "paths": {
    "/api/v1/auth/register": {
      "post": {
        "summary": "Register an ATTENDEE account",
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Missing/invalid token"
          },
          "403": {
            "description": "Insufficient role"
          },
          "404": {
            "description": "Resource absent or not owned",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "Duplicate account or stale version",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "username": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 50,
                    "pattern": "^[A-Za-z0-9._-]+$"
                  },
                  "email": {
                    "type": "string",
                    "format": "email",
                    "maxLength": 255
                  },
                  "password": {
                    "type": "string",
                    "minLength": 8,
                    "maxLength": 72,
                    "description": "At most 72 UTF-8 bytes."
                  }
                },
                "required": [
                  "username",
                  "email",
                  "password"
                ]
              }
            }
          }
        },
        "security": []
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "summary": "Sign in; RSA token expires after 1800 seconds",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "accessToken": {
                      "type": "string"
                    },
                    "tokenType": {
                      "type": "string",
                      "enum": [
                        "Bearer"
                      ]
                    },
                    "expiresIn": {
                      "type": "integer"
                    },
                    "user": {
                      "$ref": "#/components/schemas/User"
                    }
                  },
                  "required": [
                    "accessToken",
                    "tokenType",
                    "expiresIn",
                    "user"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Missing/invalid token"
          },
          "403": {
            "description": "Insufficient role"
          },
          "404": {
            "description": "Resource absent or not owned",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "Duplicate account or stale version",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "password": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "email",
                  "password"
                ]
              }
            }
          }
        },
        "security": []
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "summary": "Read authenticated account",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Missing/invalid token"
          },
          "403": {
            "description": "Insufficient role"
          },
          "404": {
            "description": "Resource absent or not owned",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "Duplicate account or stale version",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/admin/users": {
      "get": {
        "summary": "ADMIN: list accounts (unpaginated in this release)",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/User"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Missing/invalid token"
          },
          "403": {
            "description": "Insufficient role"
          },
          "404": {
            "description": "Resource absent or not owned",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "Duplicate account or stale version",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/admin/users/{userId}/roles": {
      "parameters": [
        {
          "in": "path",
          "name": "userId",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "put": {
        "summary": "ADMIN: replace roles; user must log in again for new token claims",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Missing/invalid token"
          },
          "403": {
            "description": "Insufficient role"
          },
          "404": {
            "description": "Resource absent or not owned",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "Duplicate account or stale version",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "roles": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": {
                      "type": "string",
                      "enum": [
                        "ATTENDEE",
                        "ORGANIZER",
                        "STAFF",
                        "ADMIN"
                      ]
                    }
                  }
                },
                "required": [
                  "roles"
                ]
              }
            }
          }
        }
      }
    },
    "/api/v1/profile": {
      "get": {
        "summary": "Read own reusable booking profile; empty when not saved",
        "responses": {
          "200": {
            "description": "Success; Cache-Control: no-store",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookingProfile"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required"
          }
        },
        "deprecated": true,
        "description": "Legacy default contact only (id equals user id). Use /profile/contacts for named contacts. Student ID is not retained."
      },
      "put": {
        "summary": "Replace own saved optional contact fields; does not change account email or existing bookings",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BookingProfile"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success; Cache-Control: no-store",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookingProfile"
                }
              }
            }
          },
          "400": {
            "description": "Invalid fields"
          },
          "401": {
            "description": "Authentication required"
          }
        },
        "deprecated": true,
        "description": "Legacy default contact only (id equals user id). Use /profile/contacts for named contacts. Student ID is not retained."
      },
      "delete": {
        "summary": "Clear own saved profile; order and pre-registration snapshots remain",
        "responses": {
          "204": {
            "description": "Cleared; Cache-Control: no-store"
          },
          "401": {
            "description": "Authentication required"
          }
        },
        "deprecated": true,
        "description": "Legacy default contact only (id equals user id). Use /profile/contacts for named contacts. Student ID is not retained."
      }
    },
    "/api/v1/profile/contacts": {
      "get": {
        "summary": "List all contacts owned by the current user",
        "responses": {
          "200": {
            "description": "Success; private data uses Cache-Control: no-store",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SavedContact"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Authentication required"
          }
        }
      },
      "post": {
        "summary": "Save a new named contact; no student ID is stored",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SavedContact"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success; private data uses Cache-Control: no-store",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SavedContact"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Authentication required"
          }
        }
      }
    },
    "/api/v1/profile/contacts/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "put": {
        "summary": "Replace an owned contact using its current version",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SavedContactUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success; private data uses Cache-Control: no-store",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SavedContact"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Authentication required"
          },
          "404": {
            "description": "Not owned or missing"
          },
          "409": {
            "description": "Stale version"
          }
        }
      },
      "delete": {
        "summary": "Delete an owned contact without changing submitted bookings",
        "parameters": [
          {
            "name": "version",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Authentication required"
          },
          "404": {
            "description": "Not owned or missing"
          },
          "409": {
            "description": "Stale version"
          }
        }
      }
    },
    "/api/v1/profile/username": {
      "get": {
        "summary": "Check syntax, reserved names and availability; not a reservation",
        "parameters": [
          {
            "name": "value",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success; private data uses Cache-Control: no-store",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "username": {
                      "type": "string"
                    },
                    "available": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Authentication required"
          }
        }
      },
      "put": {
        "summary": "Change own username; account email, ID, roles and bookings remain unchanged",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UsernameChange"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success; private data uses Cache-Control: no-store",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Authentication required"
          },
          "409": {
            "description": "Username already registered"
          }
        }
      }
    }
  }
}
