          }
        }
      ],
      "servers": [
        {
          "url": "http://event-catalog:8082"
        }
      ],
      "get": {
        "summary": "Internal service-only event snapshot/published",
        "security": [
          {
            "serviceToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SalesSnapshot"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Authentication required"
          },
          "404": {
            "description": "Missing or not owned"
          },
          "409": {
            "description": "State/version/quota conflict"
          }
        }
      }
    }
  }
}
