{
  "openapi": "3.0.3",
  "info": {
    "title": "SEMS Event Catalog API",
    "version": "0.9.0",
    "description": "Organization-scoped event management, recoverable publication, revisions and terminal whole-event cancellation."
  },
  "servers": [
    {
      "url": "http://localhost:18080"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "serviceToken": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Service-Token"
      }
    },
    "schemas": {
      "Problem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "fieldErrors": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      },
      "Draft": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "location": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "startsAt": {
            "type": "string",
            "format": "date-time"
          },
          "endsAt": {
            "type": "string",
            "format": "date-time",
            "description": "Must be after startsAt."
          },
          "capacity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "version": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "category": {
            "type": "string",
            "enum": [
              "GENERAL",
              "TECH",
              "EDUCATION",
              "MUSIC",
              "SPORT",
              "ART",
              "COMMUNITY"
            ],
            "default": "GENERAL"
          },
          "cardTheme": {
            "type": "string",
            "enum": [
              "LILAC",
              "LIME",
              "PEACH",
              "SKY"
            ],
            "default": "LILAC"
          },
          "registrationRequirements": {
            "$ref": "#/components/schemas/RegistrationRequirements"
          },
          "organizationId": {
            "type": "string",
            "format": "uuid"
          },
          "visibility": {
            "type": "string",
            "enum": [
              "PUBLIC",
              "ORGANIZATION_ONLY"
            ],
            "description": "PUBLIC default on creation; fixed after first publication. Organization is immutable."
          }
        },
        "required": [
          "title",
          "description",
          "location",
          "startsAt",
          "endsAt",
          "capacity",
          "organizationId"
        ]
      },
      "DraftUpdate": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "location": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "startsAt": {
            "type": "string",
            "format": "date-time"
          },
          "endsAt": {
            "type": "string",
            "format": "date-time",
            "description": "Must be after startsAt."
          },
          "capacity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "version": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "category": {
            "type": "string",
            "enum": [
              "GENERAL",
              "TECH",
              "EDUCATION",
              "MUSIC",
              "SPORT",
              "ART",
              "COMMUNITY"
            ],
            "default": "GENERAL"
          },
          "cardTheme": {
            "type": "string",
            "enum": [
              "LILAC",
              "LIME",
              "PEACH",
              "SKY"
            ],
            "default": "LILAC"
          },
          "registrationRequirements": {
            "$ref": "#/components/schemas/RegistrationRequirements"
          },
          "organizationId": {
            "type": "string",
            "format": "uuid"
          },
          "visibility": {
            "type": "string",
            "enum": [
              "PUBLIC",
              "ORGANIZATION_ONLY"
            ],
            "description": "PUBLIC default on creation; fixed after first publication. Organization is immutable."
          }
        },
        "required": [
          "title",
          "description",
          "location",
          "startsAt",
          "endsAt",
          "capacity",
          "version"
        ]
      },
      "Event": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "location": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "startsAt": {
            "type": "string",
            "format": "date-time"
          },
          "endsAt": {
            "type": "string",
            "format": "date-time",
            "description": "Must be after startsAt."
          },
          "capacity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "version": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "DRAFT",
              "PUBLISHING",
              "PUBLISHED",
              "UPDATING",
              "PAUSED",
              "CANCELLING",
              "CANCELLED"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          },
          "salesConfigured": {
            "type": "boolean"
          },
          "publicationError": {
            "type": "string",
            "nullable": true
          },
          "category": {
            "type": "string",
            "enum": [
              "GENERAL",
              "TECH",
              "EDUCATION",
              "MUSIC",
              "SPORT",
              "ART",
              "COMMUNITY"
            ],
            "default": "GENERAL"
          },
          "cardTheme": {
            "type": "string",
            "enum": [
              "LILAC",
              "LIME",
              "PEACH",
              "SKY"
            ],
            "default": "LILAC"
          },
          "registrationRequirements": {
            "$ref": "#/components/schemas/RegistrationRequirements"
          },
          "organizationId": {
            "type": "string",
            "format": "uuid"
          },
          "visibility": {
            "type": "string",
            "enum": [
              "PUBLIC",
              "ORGANIZATION_ONLY"
            ],
            "description": "PUBLIC default on creation; fixed after first publication. Organization is immutable."
          },
          "organizationName": {
            "type": "string"
          },
          "createdBy": {
            "type": "string",
            "format": "uuid"
          },
          "cancellationReason": {
            "type": "string",
            "nullable": true,
            "maxLength": 500
          }
        },
        "required": [
          "title",
          "description",
          "location",
          "startsAt",
          "endsAt",
          "capacity",
          "version",
          "id",
          "status",
          "createdAt",
          "updatedAt"
        ]
      },
      "Offering": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "location": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "startsAt": {
            "type": "string",
            "format": "date-time"
          },
          "endsAt": {
            "type": "string",
            "format": "date-time",
            "description": "Must be after startsAt."
          },
          "capacity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "category": {
            "type": "string",
            "enum": [
              "GENERAL",
              "TECH",
              "EDUCATION",
              "MUSIC",
              "SPORT",
              "ART",
              "COMMUNITY"
            ],
            "default": "GENERAL"
          },
          "cardTheme": {
            "type": "string",
            "enum": [
              "LILAC",
              "LIME",
              "PEACH",
              "SKY"
            ],
            "default": "LILAC"
          },
          "registrationRequirements": {
            "$ref": "#/components/schemas/RegistrationRequirements"
          },
          "organizationId": {
            "type": "string",
            "format": "uuid"
          },
          "visibility": {
            "type": "string",
            "enum": [
              "PUBLIC",
              "ORGANIZATION_ONLY"
            ],
            "description": "PUBLIC default on creation; fixed after first publication. Organization is immutable."
          },
          "organizationName": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "title",
          "description",
          "location",
          "startsAt",
          "endsAt",
          "capacity"
        ]
      },
      "SalesSnapshot": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "organizerId": {
            "type": "string",
            "format": "uuid"
          },
          "capacity": {
            "type": "integer"
          },
          "startsAt": {
            "type": "string",
            "format": "date-time"
          },
          "endsAt": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "registrationRequirements": {
            "$ref": "#/components/schemas/RegistrationRequirements"
          },
          "organizationId": {
            "type": "string",
            "format": "uuid"
          },
          "visibility": {
            "type": "string",
            "enum": [
              "PUBLIC",
              "ORGANIZATION_ONLY"
            ],
            "description": "PUBLIC default on creation; fixed after first publication. Organization is immutable."
          }
        },
        "required": [
          "id",
          "organizerId",
          "capacity",
          "startsAt",
          "endsAt",
          "status",
          "title",
          "location",
          "registrationRequirements"
        ]
      },
      "RegistrationRequirements": {
        "type": "object",
        "properties": {
          "realName": {
            "type": "boolean",
            "default": false
          },
          "email": {
            "type": "boolean",
            "default": false
          },
          "phone": {
            "type": "boolean",
            "default": false
          },
          "studentId": {
            "type": "boolean",
            "default": false
          },
          "passport": {
            "type": "boolean",
            "default": false
          },
          "customFieldLabel": {
            "type": "string",
            "nullable": true,
            "maxLength": 100,
            "description": "A nonblank label makes customAnswer required."
          }
        }
      },
      "PresentationUpdate": {
        "type": "object",
        "required": [
          "title",
          "description",
          "location",
          "category",
          "cardTheme",
          "version"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "location": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "category": {
            "type": "string",
            "enum": [
              "GENERAL",
              "TECH",
              "EDUCATION",
              "MUSIC",
              "SPORT",
              "ART",
              "COMMUNITY"
            ]
          },
          "cardTheme": {
            "type": "string",
            "enum": [
              "LILAC",
              "LIME",
              "PEACH",
              "SKY"
            ]
          },
          "version": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "TicketRevision": {
        "type": "object",
        "required": [
          "version",
          "ticketTypes"
        ],
        "properties": {
          "version": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "ticketTypes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "type": "object",
              "required": [
                "name",
                "quota",
                "opensAt",
                "closesAt"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "format": "uuid",
                  "description": "Existing ticket ID, omitted for a new ticket type."
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "quota": {
                  "type": "integer",
                  "minimum": 1
                },
                "opensAt": {
                  "type": "string",
                  "format": "date-time"
                },
                "closesAt": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            }
          }
        }
      },
      "RevisionInput": {
        "allOf": [
          {
            "$ref": "#/components/schemas/DraftUpdate"
          },
          {
            "type": "object",
            "properties": {
              "ticketConfiguration": {
                "$ref": "#/components/schemas/TicketRevision"
              },
              "publicationStatus": {
                "type": "string",
                "enum": [
                  "PUBLISHED",
                  "PAUSED"
                ],
                "description": "Only for events that have already been published. Omit to retain current state."
              }
            }
          }
        ]
      }
    }
  },
  "paths": {
    "/api/v1/organizer/events": {
      "get": {
        "summary": "List events in the selected organization",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Event"
                      }
                    },
                    "page": {
                      "type": "integer"
                    },
                    "size": {
                      "type": "integer"
                    },
                    "totalElements": {
                      "type": "integer"
                    },
                    "totalPages": {
                      "type": "integer"
                    }
                  },
                  "required": [
                    "items",
                    "page",
                    "size",
                    "totalElements",
                    "totalPages"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Missing/invalid token"
          },
          "403": {
            "description": "Insufficient role"
          },
          "404": {
            "description": "Resource absent or not owned",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "Duplicate account or stale version",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "in": "query",
            "name": "page",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          },
          {
            "in": "query",
            "name": "size",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 10
            }
          },
          {
            "name": "organizationId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "description": "Requires current active ORG_ADMIN or ORGANIZER membership in the event organization. Global ORGANIZER/STAFF/ADMIN roles do not bypass membership. Existing event-specific paths are retained; list/create have explicit organization context."
      },
      "post": {
        "summary": "Create organization draft; owner comes from token",
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Event"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "401": {
            "description": "Missing/invalid token"
          },
          "403": {
            "description": "Insufficient role"
          },
          "404": {
            "description": "Resource absent or not owned",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "409": {
            "description": "Duplicate account or stale version",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Draft"
              }
            }
          }
        },
        "description": "Requires current active ORG_ADMIN or ORGANIZER membership in the event organization. Global ORGANIZER/STAFF/ADMIN roles do not bypass membership. Existing event-specific paths are retained; list/create have explicit organization context."
      }
    },
