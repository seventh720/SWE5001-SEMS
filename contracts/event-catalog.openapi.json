    "/api/v1/organizer/events/{id}/publish": {
      "parameters": [
        {
          "in": "path",
          "name": "id",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "post": {
        "summary": "Organization manager: publish own event; exact request replay is idempotent",
        "description": "Requires current active ORG_ADMIN or ORGANIZER membership in the event organization. Global ORGANIZER/STAFF/ADMIN roles do not bypass membership. Existing event-specific paths are retained; list/create have explicit organization context.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "version": {
                    "type": "integer",
                    "minimum": 0,
                    "format": "int64"
                  },
                  "ticketVersion": {
                    "type": "integer",
                    "minimum": 1,
                    "format": "int64"
                  }
                },
                "required": [
                  "version",
                  "ticketVersion"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Event"
                }
              }
            }
          },
          "202": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Event"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Insufficient role"
          },
          "404": {
            "description": "Missing or not owned"
          },
          "409": {
            "description": "State/version/quota conflict"
          }
        }
      }
    },
    "/api/v1/events": {
      "get": {
        "summary": "Browse upcoming published offerings; title search and pagination",
        "security": [],
        "parameters": [
          {
            "in": "query",
            "name": "page",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          },
          {
            "in": "query",
            "name": "size",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 10
            }
          },
          {
            "in": "query",
            "name": "keyword",
            "schema": {
              "type": "string",
              "maxLength": 200,
              "default": ""
            }
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "GENERAL",
                "TECH",
                "EDUCATION",
                "MUSIC",
                "SPORT",
                "ART",
                "COMMUNITY"
              ],
              "default": "GENERAL"
            },
            "description": "Omit for all categories. Combined with title keyword search before pagination."
          },
          {
            "name": "organizationId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Offering"
                      }
                    },
                    "page": {
                      "type": "integer",
                      "minimum": 0,
                      "format": "int64"
                    },
                    "size": {
                      "type": "integer",
                      "minimum": 0,
                      "format": "int64"
                    },
                    "totalElements": {
                      "type": "integer",
                      "minimum": 0,
                      "format": "int64"
                    },
                    "totalPages": {
                      "type": "integer",
                      "minimum": 0,
                      "format": "int64"
                    }
                  },
                  "required": [
                    "items",
                    "page",
                    "size",
                    "totalElements",
                    "totalPages"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          }
        },
        "description": "Without organizationId returns public events only. Organization-scoped discovery requires active membership and includes internal offerings. Anonymous access never reveals internal events."
      }
    },
