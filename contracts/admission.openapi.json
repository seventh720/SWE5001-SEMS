{
  "openapi": "3.0.3",
  "info": {
    "title": "SEMS Admission API",
    "version": "0.8.0",
    "description": "Free inventory, retry-safe bookings, per-place ticket credentials and attendee cancellation. Staff check-in and event-wide cancellation are pending."
  },
  "servers": [
    {
      "url": "http://localhost:18080"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "serviceToken": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Service-Token"
      }
    },
    "schemas": {
      "TicketInput": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "quota": {
            "type": "integer",
            "minimum": 1
          },
          "opensAt": {
            "type": "string",
            "format": "date-time"
          },
          "closesAt": {
            "type": "string",
            "format": "date-time",
            "description": "After opening, no later than the event start."
          }
        },
        "required": [
          "name",
          "quota",
          "opensAt",
          "closesAt"
        ]
      },
      "Ticket": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "quota": {
            "type": "integer",
            "minimum": 1
          },
          "opensAt": {
            "type": "string",
            "format": "date-time"
          },
          "closesAt": {
            "type": "string",
            "format": "date-time",
            "description": "After opening, no later than the event start."
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "available": {
            "type": "integer",
            "minimum": 0
          },
          "amount": {
            "type": "integer",
            "enum": [
              0
            ]
          }
        },
        "required": [
          "name",
          "quota",
          "opensAt",
          "closesAt",
          "id",
          "available",
          "amount"
        ]
      },
      "Inventory": {
        "type": "object",
        "properties": {
          "eventId": {
            "type": "string",
            "format": "uuid"
          },
          "version": {
            "type": "integer",
            "minimum": 0,
            "format": "int64"
          },
          "state": {
            "type": "string",
            "enum": [
              "DRAFT",
              "ACTIVE",
              "PAUSED",
              "CANCELLED"
            ]
          },
          "ticketTypes": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Ticket"
            }
          }
        },
        "required": [
          "eventId",
          "version",
          "state",
          "ticketTypes"
        ]
      },
      "Configuration": {
        "type": "object",
        "properties": {
          "eventVersion": {
            "type": "integer",
            "minimum": 0,
            "format": "int64"
          },
          "version": {
            "type": "integer",
            "minimum": 0,
            "format": "int64"
          },
          "ticketTypes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "$ref": "#/components/schemas/TicketInput"
            }
          }
        },
        "required": [
          "eventVersion",
          "version",
          "ticketTypes"
        ]
      },
      "BookingRequest": {
        "type": "object",
        "properties": {
          "requestKey": {
            "type": "string",
            "format": "uuid"
          },
          "eventId": {
            "type": "string",
            "format": "uuid"
          },
          "ticketTypeId": {
            "type": "string",
            "format": "uuid"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "attendeeInfo": {
            "$ref": "#/components/schemas/AttendeeInfo"
          }
        },
        "required": [
          "requestKey",
          "eventId",
          "ticketTypeId",
          "quantity"
        ]
      },
      "IssuedTicket": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "credential": {
            "type": "string",
            "description": "Private, unique 48-character hexadecimal credential. QR payload is exactly this value; manual entry uses the same value."
          },
          "state": {
            "type": "string",
            "enum": [
              "VALID",
              "CHECKED_IN",
              "CANCELLED"
            ]
          }
        },
        "required": [
          "id",
          "credential",
          "state"
        ]
      },
      "Booking": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "eventId": {
            "type": "string",
            "format": "uuid"
          },
          "ticketTypeId": {
            "type": "string",
            "format": "uuid"
          },
          "quantity": {
            "type": "integer"
          },
          "status": {
            "type": "string",
            "enum": [
              "CONFIRMED",
              "CANCELLED"
            ]
          },
          "eventTitle": {
            "type": "string"
          },
          "eventLocation": {
            "type": "string"
          },
          "startsAt": {
            "type": "string",
            "format": "date-time"
          },
          "endsAt": {
            "type": "string",
            "format": "date-time"
          },
          "ticketName": {
            "type": "string"
          },
          "amount": {
            "type": "integer",
            "enum": [
              0
            ],
            "description": "Free bookings only; calculated by the server."
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "tickets": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/IssuedTicket"
            }
          },
          "attendeeInfo": {
            "$ref": "#/components/schemas/AttendeeInfo"
          },
          "customFieldLabel": {
            "type": "string",
            "nullable": true,
            "description": "Historical event question at booking time."
          },
          "eventCancellationReason": {
            "type": "string",
            "nullable": true,
            "description": "Present when cancelled by the organizer. Checked-in ticket history is retained, but none of the tickets may be admitted again."
          }
        },
        "required": [
          "id",
          "eventId",
          "ticketTypeId",
          "quantity",
          "status",
          "eventTitle",
          "eventLocation",
          "startsAt",
          "endsAt",
          "ticketName",
          "amount",
          "createdAt",
          "tickets"
        ]
      },
      "BookingPage": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Booking"
            }
          },
          "page": {
            "type": "integer"
          },
          "size": {
            "type": "integer"
          },
          "totalElements": {
            "type": "integer",
            "format": "int64"
          },
          "totalPages": {
            "type": "integer",
            "format": "int64"
          }
        },
        "required": [
          "items",
          "page",
          "size",
          "totalElements",
          "totalPages"
        ]
      },
      "AttendeeInfo": {
        "type": "object",
        "description": "One booking contact per order, not one form per ticket. Only requested fields may be supplied. Values are trimmed; blank values normalize to null. Requested fields must be nonblank.",
        "properties": {
          "realName": {
            "type": "string",
            "nullable": true,
            "maxLength": 100
          },
          "email": {
            "type": "string",
            "nullable": true,
            "maxLength": 254,
            "format": "email"
          },
          "phone": {
            "type": "string",
            "nullable": true,
            "maxLength": 40
          },
          "studentId": {
            "type": "string",
            "nullable": true,
            "maxLength": 100
          },
          "passportNumber": {
            "type": "string",
            "nullable": true,
            "maxLength": 100
          },
          "customAnswer": {
            "type": "string",
            "nullable": true,
            "maxLength": 500
          }
        }
      },
      "OrganizerBooking": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "CONFIRMED",
              "CANCELLED"
            ]
          },
          "ticketName": {
            "type": "string"
          },
          "quantity": {
            "type": "integer"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "attendeeInfo": {
            "$ref": "#/components/schemas/AttendeeInfo"
          },
          "customFieldLabel": {
            "type": "string",
            "nullable": true,
            "description": "Historical event question at booking time."
          }
        },
        "description": "No ticket credentials or user account details are returned."
      },
      "OrganizerBookingPage": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OrganizerBooking"
            }
          },
          "page": {
            "type": "integer"
          },
          "size": {
            "type": "integer"
          },
          "totalElements": {
            "type": "integer",
            "format": "int64"
          },
          "totalPages": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "PreRegistrationInput": {
        "type": "object",
        "required": [
          "ticketTypeId",
          "quantity"
        ],
        "properties": {
          "ticketTypeId": {
            "type": "string",
            "format": "uuid"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10
          },
          "attendeeInfo": {
            "$ref": "#/components/schemas/AttendeeInfo"
          }
        }
      },
      "PreRegistration": {
        "allOf": [
          {
            "$ref": "#/components/schemas/PreRegistrationInput"
          },
          {
            "type": "object",
            "properties": {
              "eventId": {
                "type": "string",
                "format": "uuid"
              },
              "eventTitle": {
                "type": "string"
              },
              "eventLocation": {
                "type": "string"
              },
              "ticketName": {
                "type": "string"
              },
              "opensAt": {
                "type": "string",
                "format": "date-time"
              },
              "closesAt": {
                "type": "string",
                "format": "date-time"
              },
              "startsAt": {
                "type": "string",
                "format": "date-time"
              },
              "customFieldLabel": {
                "type": "string",
                "nullable": true
              },
              "status": {
                "type": "string",
                "enum": [
                  "WAITING",
                  "READY",
                  "SOLD_OUT",
                  "CLOSED"
                ]
              }
            }
          }
        ]
      },
      "PreRegistrationPage": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PreRegistration"
            }
          },
          "page": {
            "type": "integer"
          },
          "size": {
            "type": "integer"
          },
          "totalElements": {
            "type": "integer"
          },
          "totalPages": {
            "type": "integer"
          }
        }
      },
      "EventRevision": {
        "type": "object",
        "required": [
          "operationId",
          "eventId",
          "organizerId",
          "sourceStatus",
          "oldCapacity",
          "oldStartsAt",
          "oldEndsAt",
          "desired"
        ],
        "properties": {
          "operationId": {
            "type": "string",
            "format": "uuid"
          },
          "eventId": {
            "type": "string",
            "format": "uuid"
          },
          "organizerId": {
            "type": "string",
            "format": "uuid"
          },
          "sourceStatus": {
            "type": "string",
            "enum": [
              "DRAFT",
              "PUBLISHED",
              "PAUSED"
            ]
          },
          "oldCapacity": {
            "type": "integer",
            "minimum": 1
          },
          "oldStartsAt": {
            "type": "string",
            "format": "date-time"
          },
          "oldEndsAt": {
            "type": "string",
            "format": "date-time"
          },
          "desired": {
            "type": "object",
            "required": [
              "capacity",
              "startsAt",
              "endsAt"
            ],
            "properties": {
              "capacity": {
                "type": "integer",
                "minimum": 1
              },
              "startsAt": {
                "type": "string",
                "format": "date-time"
              },
              "endsAt": {
                "type": "string",
                "format": "date-time"
              },
              "ticketConfiguration": {
                "$ref": "#/components/schemas/TicketRevision"
              },
              "publicationStatus": {
                "type": "string",
                "enum": [
                  "PUBLISHED",
                  "PAUSED"
                ],
                "description": "Only for events that have already been published. Omit to retain current state."
              }
            }
          },
          "organizationId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "TicketRevision": {
        "type": "object",
        "required": [
          "version",
          "ticketTypes"
        ],
        "properties": {
          "version": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "ticketTypes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "type": "object",
              "required": [
                "name",
                "quota",
                "opensAt",
                "closesAt"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "format": "uuid",
                  "description": "Existing ticket ID, omitted for a new ticket type."
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "quota": {
                  "type": "integer",
                  "minimum": 1
                },
                "opensAt": {
                  "type": "string",
                  "format": "date-time"
                },
                "closesAt": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            }
          }
        }
      },
      "StaffAssignment": {
        "type": "object",
        "properties": {
          "eventId": {
            "type": "string",
            "format": "uuid"
          },
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "active": {
            "type": "boolean"
          }
        }
      },
      "StaffTask": {
        "type": "object",
        "properties": {
          "eventId": {
            "type": "string",
            "format": "uuid"
          },
          "organizationId": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "startsAt": {
            "type": "string",
            "format": "date-time"
          },
          "endsAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "CheckInResult": {
        "type": "object",
        "properties": {
          "ticketId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "CHECKED_IN"
            ]
          },
          "checkedInAt": {
            "type": "string",
            "format": "date-time"
          },
          "alreadyCheckedIn": {
            "type": "boolean"
          }
        }
      },
      "EventSummary": {
        "type": "object",
        "properties": {
          "confirmedTickets": {
            "type": "integer"
          },
          "availableCapacity": {
            "type": "integer"
          },
          "attendance": {
            "type": "integer"
          },
          "salesState": {
            "type": "string",
            "enum": [
              "DRAFT",
              "ACTIVE",
              "PAUSED",
              "CANCELLED"
            ]
          }
        }
      },
      "Notification": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "link": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "readAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        }
      },
      "NotificationPage": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Notification"
            }
          },
          "unreadCount": {
            "type": "integer"
          },
          "hasMore": {
            "type": "boolean"
          }
        }
      },
      "CancellationOperation": {
        "type": "object",
        "required": [
          "eventId",
          "operationId",
          "reason"
        ],
        "properties": {
          "eventId": {
            "type": "string",
            "format": "uuid"
          },
          "operationId": {
            "type": "string",
            "format": "uuid"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        }
      }
    }
  },
  "paths": {
    "/api/v1/organizer/events/{id}/ticket-types": {
      "parameters": [
        {
          "in": "path",
          "name": "id",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "get": {
        "summary": "ORGANIZER/ADMIN: read only own inventory configuration",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Inventory"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Insufficient role"
          },
          "404": {
            "description": "Missing or not owned"
          },
          "503": {
            "description": "Dependency unavailable"
          }
        },
        "description": "Requires live organization manager membership via Catalog. No global role bypass."
      },
      "put": {
        "summary": "Replace draft ticket types using event and inventory versions",
        "description": "Requires live organization manager membership via Catalog. No global role bypass.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Configuration"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Inventory"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Insufficient role"
          },
          "404": {
            "description": "Missing or not owned"
          },
          "409": {
            "description": "State/version/quota conflict"
          },
          "503": {
            "description": "Dependency unavailable"
          }
        }
      }
    },
    "/api/v1/events/{id}/ticket-types": {
      "parameters": [
        {
          "in": "path",
          "name": "id",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "get": {
        "summary": "Anonymous inventory for a future published event",
        "security": [],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Inventory"
                }
              }
            }
          },
          "400": {
            "description": "Invalid input"
          },
          "404": {
            "description": "Missing or not owned"
          },
          "503": {
            "description": "Dependency unavailable"
          }
        }
      }
    },
    "/internal/v1/events/{id}/activate-sales": {
      "parameters": [
        {
          "in": "path",
          "name": "id",
          "required": true,
          "schema": {
            "type": "string",
            "format": "uuid"
          }
        }
      ],
      "servers": [
        {
          "url": "http://admission:8083"
        }
      ],
      "post": {
        "summary": "Catalog-only activation; same operation and snapshot can be retried",
        "security": [
          {
            "serviceToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "operationId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "organizerId": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "capacity": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "startsAt": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "endsAt": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "ticketVersion": {
                    "type": "integer",
                    "minimum": 1,
                    "format": "int64"
                  }
                },
                "required": [
                  "operationId",
                  "organizerId",
                  "capacity",
                  "startsAt",
                  "endsAt",
                  "ticketVersion"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Activated or identical operation already applied"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Authentication required"
          },
          "409": {
            "description": "State/version/quota conflict"
          }
        }
      }
    },
    "/api/v1/bookings": {
      "post": {
        "summary": "Confirm a free booking and issue one ticket per place",
        "description": "New internal-event requests require active organization membership. Existing owned booking replay remains available after membership removal.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BookingRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success; Cache-Control: no-store",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string"
                },
                "description": "no-store"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Booking"
                }
              }
            }
          },
          "400": {
            "description": "Malformed request or invalid quantity/pagination"
          },
          "401": {
            "description": "Authentication required"
          },
          "404": {
            "description": "Resource unavailable or owned by another attendee"
          },
          "409": {
            "description": "Request key payload mismatch, insufficient inventory, closed sales or cancellation forbidden"
          },
          "503": {
